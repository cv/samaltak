testIncrementalSplits
	| key m expected mac |
	key := (1 to: 32) asByteArray.
	m := (1 to: 70) asByteArray.
	expected := Poly1305 key: key message: m.
	0 to: m size do: [:i |
		mac := Poly1305 key: key.
		mac update: (m copyFrom: 1 to: i); update: m from: i + 1 to: m size.
		self assert: mac digest equals: expected.
		self assert: mac digest equals: expected]
!
testKeySize
	self should: [Poly1305 key: (ByteArray new: 16)] raise: CryptoError
! !
