!NvRasterKernels class methodsFor: 'abi'!
kernelNames
	^#('raster_prims' 'raster_tiles' 'raster_fill' 'raster_copy' 'raster_blit')
!
kernel: aString
	"The kernel named aString: a Dictionary of entry (its symbol), params (the name of its parameter struct), block (the threads per block it is written for), registers, frameBytes and stackBytes (per thread: local memory), sharedBytes (the static shared memory a block needs, the 1 KB sm_90 and later reserve included), paramOffset and paramBytes (its parameters in constant bank 0), constantBank0Bytes (the bank's size), constantBank2 (bytes to bind as constant bank 2, or nil), textBytes."
	| d |
	d := Dictionary new.
	aString = 'raster_prims' ifTrue: [
		d at: #entry put: 'raster_prims';
			at: #params put: 'RasterDrawParams';
			at: #block put: 256;
			at: #registers put: 155;
			at: #frameBytes put: 0;
			at: #stackBytes put: 0;
			at: #sharedBytes put: 1024;
			at: #paramOffset put: 896;
			at: #paramBytes put: 200;
			at: #constantBank0Bytes put: 1096;
			at: #constantBank2 put: nil;
			at: #textBytes put: 63104.
		^d].
	aString = 'raster_tiles' ifTrue: [
		d at: #entry put: 'raster_tiles';
			at: #params put: 'RasterDrawParams';
			at: #block put: 256;
			at: #registers put: 48;
			at: #frameBytes put: 0;
			at: #stackBytes put: 0;
			at: #sharedBytes put: 6176;
			at: #paramOffset put: 896;
			at: #paramBytes put: 200;
			at: #constantBank0Bytes put: 1096;
			at: #constantBank2 put: #[128 39 0 0 16 26 0 0 112 210 0 0 112 42 0 0 112 46 0 0 112 210 0 0 144 210 0 0 16 252 0 0 144 57 0 0 112 210 0 0];
			at: #textBytes put: 101888.
		^d].
	aString = 'raster_fill' ifTrue: [
		d at: #entry put: 'raster_fill';
			at: #params put: 'RasterFillParams';
			at: #block put: 256;
			at: #registers put: 24;
			at: #frameBytes put: 0;
			at: #stackBytes put: 0;
			at: #sharedBytes put: 1024;
			at: #paramOffset put: 896;
			at: #paramBytes put: 24;
			at: #constantBank0Bytes put: 920;
			at: #constantBank2 put: nil;
			at: #textBytes put: 4224.
		^d].
	aString = 'raster_copy' ifTrue: [
		d at: #entry put: 'raster_copy';
			at: #params put: 'RasterCopyParams';
			at: #block put: 256;
			at: #registers put: 40;
			at: #frameBytes put: 0;
			at: #stackBytes put: 0;
			at: #sharedBytes put: 1024;
			at: #paramOffset put: 896;
			at: #paramBytes put: 64;
			at: #constantBank0Bytes put: 960;
			at: #constantBank2 put: nil;
			at: #textBytes put: 10496.
		^d].
	aString = 'raster_blit' ifTrue: [
		d at: #entry put: 'raster_blit';
			at: #params put: 'RasterBlitParams';
			at: #block put: 256;
			at: #registers put: 56;
			at: #frameBytes put: 0;
			at: #stackBytes put: 0;
			at: #sharedBytes put: 1024;
			at: #paramOffset put: 896;
			at: #paramBytes put: 128;
			at: #constantBank0Bytes put: 1024;
			at: #constantBank2 put: nil;
			at: #textBytes put: 120192.
		^d].
	^self error: 'no raster kernel ', aString printString
!
structNames
	^#(#RasterBlitParams #RasterCopyParams #RasterDrawParams #RasterFillParams)
!
layoutOf: aSymbol
	"The fields of the parameter struct aSymbol (raster_abi.h): {name. type (#uint64 #int64 #float64 #int32 #uint32). byte offset. count}."
	aSymbol = #RasterBlitParams ifTrue: [^#(#(#src #uint64 0 1) #(#srcWidth #int64 8 1) #(#srcHeight #int64 16 1) #(#dst #uint64 24 1) #(#dstWidth #int64 32 1) #(#dstHeight #int64 40 1) #(#srcRect #int64 48 4) #(#dstRect #int64 80 4) #(#srcFormat #int32 112 1) #(#dstFormat #int32 116 1) #(#linear #int32 120 1) #(#pad #int32 124 1))].
	aSymbol = #RasterCopyParams ifTrue: [^#(#(#dst #uint64 0 1) #(#dstStride #int64 8 1) #(#src #uint64 16 1) #(#srcStride #int64 24 1) #(#width #int64 32 1) #(#height #int64 40 1) #(#bpp #int64 48 1) #(#mode #int64 56 1))].
	aSymbol = #RasterDrawParams ifTrue: [^#(#(#pixels #uint64 0 1) #(#width #int64 8 1) #(#height #int64 16 1) #(#scissorX #int64 24 1) #(#scissorY #int64 32 1) #(#scissorW #int64 40 1) #(#scissorH #int64 48 1) #(#viewportX #float64 56 1) #(#viewportY #float64 64 1) #(#viewportW #float64 72 1) #(#viewportH #float64 80 1) #(#viewSizeX #float64 88 1) #(#viewSizeY #float64 96 1) #(#translateX #float64 104 1) #(#translateY #float64 112 1) #(#texture #uint64 120 1) #(#textureWidth #int64 128 1) #(#textureHeight #int64 136 1) #(#vertices #uint64 144 1) #(#first #int64 152 1) #(#count #int64 160 1) #(#prims #uint64 168 1) #(#format #int32 176 1) #(#blend #int32 180 1) #(#textureFormat #int32 184 1) #(#linear #int32 188 1) #(#repeat #int32 192 1) #(#pad #int32 196 1))].
	aSymbol = #RasterFillParams ifTrue: [^#(#(#pixels #uint64 0 1) #(#count #int64 8 1) #(#bpp #int32 16 1) #(#value #uint32 20 1))].
	^self error: 'no parameter struct ', aSymbol printString
!
sizeOf: aSymbol
	aSymbol = #RasterBlitParams ifTrue: [^128].
	aSymbol = #RasterCopyParams ifTrue: [^64].
	aSymbol = #RasterDrawParams ifTrue: [^200].
	aSymbol = #RasterFillParams ifTrue: [^24].
	^self error: 'no parameter struct ', aSymbol printString
!
primBytes
	"RASTER_PRIM_BYTES (raster_abi.h)."
	^400
!
scratchHeader
	"RASTER_SCRATCH_HEADER (raster_abi.h)."
	^64
!
tile
	"RASTER_TILE (raster_abi.h)."
	^16
!
tileThreads
	"RASTER_TILE_THREADS (raster_abi.h)."
	^256
!
drawScratchBytes: vertexCount
	"The scratch a draw of vertexCount vertices needs (RasterDrawParams prims)."
	^self scratchHeader + (self primBytes * (vertexCount // 3))
! !

!NvRasterKernels class methodsFor: 'parameters'!
params: aSymbol with: associations
	"The bytes of the parameter struct aSymbol with the fields named in associations (field -> value; an array field takes an Array); the others zero. Integers as two's complement, floats as IEEE doubles, booleans 0 or 1."
	| bytes values |
	bytes := ByteArray new: (self sizeOf: aSymbol).
	values := Dictionary new.
	associations do: [:a | values at: a key put: a value].
	(self layoutOf: aSymbol) do: [:f |
		(values includesKey: f first) ifTrue: [
			| v |
			v := values removeKey: f first.
			(f at: 4) = 1
				ifTrue: [self put: v type: (f at: 2) at: (f at: 3) into: bytes]
				ifFalse: [
					v size = (f at: 4) ifFalse: [^self error: f first , ' takes ' , (f at: 4) printString , ' values'].
					v doWithIndex: [:x :i | self put: x type: (f at: 2) at: (f at: 3) + ((i - 1) * ((f at: 2) == #int32 | ((f at: 2) == #uint32) ifTrue: [4] ifFalse: [8])) into: bytes]]]].
	values isEmpty ifFalse: [^self error: aSymbol , ' has no field ' , values keys asArray first printString].
	^bytes
!
put: aValue type: aType at: offset into: bytes
	"Store aValue as aType at the 0-based byte offset of bytes."
	| v |
	aType == #float64 ifTrue: [^bytes float64At: offset + 1 put: aValue asFloat].
	v := aValue == true ifTrue: [1] ifFalse: [aValue == false ifTrue: [0] ifFalse: [aValue]].
	bytes uint32At: offset + 1 put: (v bitAnd: 16rFFFFFFFF).
	(aType == #int32 or: [aType == #uint32]) ifFalse: [bytes uint32At: offset + 5 put: ((v bitShift: -32) bitAnd: 16rFFFFFFFF)]
! !
