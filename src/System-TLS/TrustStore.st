Object subclass: #TrustStore
	instanceVariableNames: 'bySubject certificates'
	classVariableNames: 'Default'
	package: 'System-TLS'!

TrustStore comment: 'I am a set of trust anchors: X509Certificates whose keys a CertificateValidator trusts to end a path, found by subject.

	TrustStore default.	"Mozilla''s roots, from TrustStoreRoots (generated by tools/ca-bundle-to-smalltalk.py), parsed on first use"
	TrustStore new add: caCertificate; yourself.	"one''s own, e.g. a test''s CA"

add: takes an X509Certificate or its DER; roots whose keys I cannot use (P-521...) are kept but never verify anything.'!

!TrustStore methodsFor: 'accessing'!
add: aCertificateOrDer
	"Trust aCertificateOrDer (an X509Certificate or its DER); answer the certificate."
	| cert |
	cert := (aCertificateOrDer isKindOf: X509Certificate)
		ifTrue: [aCertificateOrDer]
		ifFalse: [X509Certificate fromDer: aCertificateOrDer].
	(self includes: cert) ifTrue: [^cert].
	certificates add: cert.
	(bySubject at: cert subject ifAbsentPut: [OrderedCollection new]) add: cert.
	^cert
!
addAll: aCollection
	aCollection do: [:each | self add: each].
	^aCollection
!
certificates
	^certificates asArray
!
size
	^certificates size
!
anchorsNamed: anX509Name
	"The anchors whose subject is anX509Name."
	^(bySubject at: anX509Name ifAbsent: [#()]) asArray
!
issuersOf: aCertificate
	"The anchors that could have issued aCertificate: those whose subject is its issuer."
	^self anchorsNamed: aCertificate issuer
!
commonNames
	^certificates collect: [:each | each subject commonName]
! !

!TrustStore methodsFor: 'testing'!
includes: aCertificate
	"Whether aCertificate is one of my anchors, byte for byte."
	^(bySubject at: aCertificate subject ifAbsent: [#()]) includes: aCertificate
! !

!TrustStore methodsFor: 'printing'!
printOn: aStream
	aStream nextPutAll: 'a TrustStore ('; print: certificates size; nextPutAll: ' anchors)'
! !

!TrustStore methodsFor: 'private'!
initialize
	bySubject := Dictionary new.
	certificates := OrderedCollection new
! !

!TrustStore class methodsFor: 'instance creation'!
new
	^super new initialize
!
default
	"The roots of TrustStoreRoots (Mozilla's, as the CA bundle had them when it was generated), parsed on first use."
	Default isNil ifTrue: [Default := self fromRoots].
	^Default
!
fromRoots
	| store pairs |
	store := self new.
	pairs := TrustStoreRoots namesAndCertificates.
	2 to: pairs size by: 2 do: [:i | store add: (Base64 decode: (pairs at: i))].
	^store
!
resetDefault
	"Forget the parsed default, e.g. after TrustStoreRoots was regenerated."
	Default := nil
! !
