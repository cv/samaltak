Object subclass: #DisplayFont
	instanceVariableNames: 'glyphs reversed'
	classVariableNames: ''
	package: 'ST80-UI'!

DisplayFont comment: 'The X11 misc-fixed 7x14 font, with blank top and bottom rows. Each cached row is one byte, high bit leftmost; characters outside ASCII 32..126 are blank.'!

!DisplayFont methodsFor: 'initialization'!
initialize
	glyphs := Array new: 96.
	reversed := Array new: 96.
	glyphs at: 96 put: (ByteArray new: 16).
	reversed at: 96 put: (ByteArray new: 16 withAll: 254)
! !

!DisplayFont methodsFor: 'accessing'!
rowsFor: code reversed: aBoolean
	| index cache rows normal |
	index := (code between: 32 and: 126) ifTrue: [code - 31] ifFalse: [96].
	cache := aBoolean ifTrue: [reversed] ifFalse: [glyphs].
	rows := cache at: index.
	rows isNil ifFalse: [^rows].
	aBoolean
		ifTrue: [
			normal := self rowsFor: code reversed: false.
			rows := normal collect: [:b | 254 - b]]
		ifFalse: [rows := self decode: (self class glyphRows at: index)].
	^cache at: index put: rows
! !

!DisplayFont methodsFor: 'private'!
decode: hex
	| rows |
	rows := ByteArray new: 16.
	1 to: 16 do: [:i |
		rows at: i put: ((hex at: i * 2 - 1) digitValue * 16 + (hex at: i * 2) digitValue)].
	^rows
! !

