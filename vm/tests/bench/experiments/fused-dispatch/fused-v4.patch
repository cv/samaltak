diff --git a/src/VM-Jit/FFIPrimitives-direct.extension.st b/src/VM-Jit/FFIPrimitives-direct.extension.st
new file mode 100644
index 0000000..7fe194e
--- /dev/null
+++ b/src/VM-Jit/FFIPrimitives-direct.extension.st
@@ -0,0 +1,144 @@
+!FFIPrimitives methodsFor: '*VM-Jit'!
+primFFIDirectSite
+	<vmPrimitive: 266 name: 'ffiDirectSite'>
+	self fail
+!
+configureDirect
+	| flag |
+	flag := libc getenv: 'SAMALTAK_FFI_DIRECT'.
+	directEnabledFlag := flag notNull and: [(libc strcmp: flag with: '1') = 0 and: [ffiStubs canPublishCode]].
+	flag := libc getenv: 'SAMALTAK_FFI_DIRECT_TRACE'.
+	directTrace := flag notNull and: [(libc strcmp: flag with: '1') = 0]
+!
+directEnabled
+	<returns: 'bool'>
+	^directEnabledFlag
+!
+isDirectDescriptor: descriptor result: tag fallback: fallback requireAvailable: available
+	"Cold trial admission. Names and fallback selectors are not emitted into the thunk."
+	<function>
+	<var: #descriptor type: 'oop'>
+	<var: #tag type: 'int32_t'>
+	<var: #fallback type: 'oop'>
+	<var: #available type: 'bool'>
+	<returns: 'bool'>
+	| types arg lib sym libName symName target signedSig |
+	(tag = 6 or: [tag = 12]) ifFalse: [^false].
+	((self isArray: descriptor count: 4) and: [self isImmutable: descriptor]) ifFalse: [^false].
+	(self loadRef: descriptor at: 3) = (self intOop: tag) ifFalse: [^false].
+	types := self loadRef: descriptor at: 2.
+	(types ~= 0 and: [(self isByteArray: types) and: [
+		(self isImmutable: types) and: [(self byteCount: types) = 1]]]) ifFalse: [^false].
+	arg := (self bytesOf: types) at: 0.
+	(tag = 6 ifTrue: [arg = 6] ifFalse: [arg = 3]) ifFalse: [^false].
+	libName := self loadRef: descriptor at: 0.
+	symName := self loadRef: descriptor at: 1.
+	(libName ~= 0 and: [symName ~= 0 and: [(self isPtr: libName) and: [(self isPtr: symName) and: [
+		(self isImmutable: libName) and: [self isImmutable: symName]]]]]) ifFalse: [^false].
+	lib := self local: 'uint8_t[128]'.
+	sym := self local: 'uint8_t[128]'.
+	((self copyName: libName into: lib) = 0 or: [(self copyName: symName into: sym) = 0]) ifTrue: [^false].
+	tag = 6
+		ifTrue: [
+			((libc strcmp: (self cCoerce: lib to: 'const char *') with: 'vm:core') = 0 and: [
+				(libc strcmp: (self cCoerce: sym to: 'const char *') with: 'core_float_fraction_part') = 0 and: [
+				fallback = 0 or: [self directFallback: fallback equals: 'fractionPart']]]) ifFalse: [^false]]
+		ifFalse: [
+			(libc strcmp: (self cCoerce: lib to: 'const char *') with: 'platform') = 0 ifFalse: [^false].
+			(libc strcmp: (self cCoerce: sym to: 'const char *') with: 'platform_files_size') = 0
+				ifTrue: [(fallback = 0 or: [(self directFallback: fallback equals: 'primSize:') or: [
+					self directFallback: fallback equals: 'ffiLegacyPrimSize:']]) ifFalse: [^false]]
+				ifFalse: [((libc strcmp: (self cCoerce: sym to: 'const char *') with: 'platform_files_position') = 0 and: [
+					fallback = 0 or: [(self directFallback: fallback equals: 'primPosition:') or: [
+						self directFallback: fallback equals: 'ffiLegacyPrimPosition:']]]) ifFalse: [^false]]].
+	available ifFalse: [^true].
+	target := self local: 'uint64_t'.
+	signedSig := ((arg asUInt64 << 4) bitOr: tag asUInt64) asUInt32.
+	tag = 6
+		ifTrue: [self ffiApprovedCore: (self cCoerce: sym to: 'const char *') signature: signedSig into: target]
+		ifFalse: [platform ffiApprovedPlatform: (self cCoerce: sym to: 'const char *') signature: signedSig into: target].
+	^target value ~= 0
+!
+directFallback: selector equals: name
+	<var: #selector type: 'oop'>
+	<var: #name type: 'const char *'>
+	<returns: 'bool'>
+	| size |
+	(selector ~= 0 and: [(self isPtr: selector) and: [
+		(self rawClass: selector) = (memory special: SO_BYTESYMBOL) and: [(self formatOf: selector) >= F_BYTES]]]) ifFalse: [^false].
+	size := libc strlen: name.
+	^(memory byteSize: selector) = size and: [(libc memcmp: (self bytesOf: selector) with: name size: size) = 0]
+!
+directMethodLiterals: method argc: n
+	"Caller has checked the method's fixed shape and marker."
+	<var: #method type: 'oop'>
+	<var: #n type: 'int32_t'>
+	<returns: 'oop'>
+	<var: #literals type: 'oop'>
+	| literals |
+	(directEnabledFlag and: [n = 0 or: [n = 1]]) ifFalse: [^0 asUInt64].
+	literals := self loadRef: method at: CM_LITERALS.
+	((self isArray: literals count: 3) and: [self isImmutable: literals]) ifFalse: [^0 asUInt64].
+	^literals
+!
+directBindingPending: method argc: n
+	"Only the otherwise admissible cold binding may be deferred by the JIT.
+	Do not defer indefinitely: wrapper publication or session setup can fail."
+	<function>
+	<var: #method type: 'oop'>
+	<var: #n type: 'int32_t'>
+	<returns: 'bool'>
+	| literals owner arity |
+	literals := self directMethodLiterals: method argc: n.
+	literals = 0 ifTrue: [^false].
+	owner := self loadRef: literals at: 0.
+	arity := self local: 'int32_t'.
+	(self boundEntry: owner into: arity) = 0 ifFalse: [^false].
+	^self isDirectDescriptor: (self loadRef: owner at: 0) result: (n = 0 ifTrue: [6] ifFalse: [12])
+		fallback: (self loadRef: literals at: 2) requireAvailable: true
+!
+resolveDirectMethod: method argc: n
+	"Cold lookup on a shape-validated marker method. No allocation on the VM heap, no preparation, no library lookup. Only the marker opts a method into using its first literal as a binding."
+	<function>
+	<var: #method type: 'oop'>
+	<var: #n type: 'int32_t'>
+	<returns: 'prim_fn'>
+	<var: #entries type: 'uint64_t *'>
+	| literals owner desc slot entries entry site target |
+	literals := self directMethodLiterals: method argc: n.
+	literals = 0 ifTrue: [^self null].
+	owner := self loadRef: literals at: 0.
+	desc := self local: 'FFIBoundSite'.
+	(self describeBoundOwner: owner arity: 1 into: desc) ifFalse: [^self null].
+	"Publication is memoized per weak slot and argument convention. The loaded slot is the authorized weak entry, not a new strong root."
+	slot := ((self intVal: desc token) bitAnd: FFI_BINDING_LIMIT - 1) asInt32.
+	target := directTargets at: slot.
+	target = 0 ifTrue: [^self null].
+	((bindingResultTags at: slot) = 6 ifTrue: [n = 0] ifFalse: [n = 1]) ifFalse: [^self null].
+	(self isDirectDescriptor: (self loadRef: owner at: 0) result: (bindingResultTags at: slot) asInt32
+		fallback: (self loadRef: literals at: 2) requireAvailable: false) ifFalse: [^self null].
+	entries := n = 0 ifTrue: [directReceiverEntries + 0] ifFalse: [directArgEntries + 0].
+	entry := entries at: slot.
+	entry = 0 ifTrue: [
+		site := self local: 'FFIDirectABI'.
+		site base: interpreter primStackBaseCell.
+		site result: interpreter primResultCell.
+		site status: interpreter primStatusCell.
+		site errorCell: interpreter primErrorCell.
+		site okStatus: PS_OK.
+		site failStatus: PS_FAIL.
+		site stressBox: (libc getenv: 'SAMALTAK_FFI_BOX_FULL_GC') notNull.
+		site floatClass: memory boxedFloatClassCell.
+		site target: target.
+		site counts: (directTrace ifTrue: [self cCoerce: directCounts to: 'uint64_t'] ifFalse: [0 asUInt64]).
+		entry := ffiStubs directEntryFor: desc explicitArgs: n ~= 0 abi: site.
+		entry = 0 ifTrue: [^self null].
+		entries at: slot put: entry.
+		directTrace ifTrue: [directCounts at: 0 put: (directCounts at: 0) + 1]].
+	^self cCoerce: entry to: 'prim_fn'
+!
+printDirectTrace
+	directTrace ifTrue: [
+		libc fprintf: libc stderr format: 'ffi-direct trace published=%llu success=%llu reject=%llu\n'
+			with: (directCounts at: 0) with: (directCounts at: 1) with: (directCounts at: 2)]
+! !
