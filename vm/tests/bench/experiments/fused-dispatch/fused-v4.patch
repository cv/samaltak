--- /dev/null
+++ b/tests/vm/ffi_direct_test.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Observe matched native entries and direct prim results through cold/warm/GC/relink."""
+import argparse
+import collections
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ap = argparse.ArgumentParser(description=__doc__)
+ap.add_argument("vm", type=Path)
+ap.add_argument("image", type=Path)
+ap.add_argument("evidence", type=Path)
+ap.add_argument("--old-image", action="store_true", help="no marker expected")
+ap.add_argument("--mode", action="append", choices=("none", "baseline", "opt", "deopt"))
+args = ap.parse_args()
+args.evidence.mkdir(parents=True)
+n = 120
+body = """
+| float method expected run path h |
+float := Float fromIEEEBits: 16rC006000000000000.
+expected := float fractionPart asIEEEBits.
+method := Float compiledMethodAt: #ffiCandidateFractionPart.
+run := [:count | count timesRepeat: [
+    float ffiCandidateFractionPart asIEEEBits = expected ifFalse: [self error: 'wrong float result']]].
+run value: @LOOP_COUNT@.
+Smalltalk vm garbageCollect.
+run value: @LOOP_COUNT@.
+[
+    Compiler compile: 'ffiCandidateFractionPart <primitive: 266> ^17' in: Float.
+    float ffiCandidateFractionPart = 17 ifFalse: [self error: 'stale linked marker after method replacement']
+] ensure: [Float addSelectorSilently: #ffiCandidateFractionPart withMethod: method].
+run value: @LOOP_COUNT@.
+Compiler compile: 'ffiDirectDeniedSqrt
+    <ffiSite>
+    <primitive: 266>
+    | answer |
+    answer := (self ffiSite: #(call ''libm'' ''sqrt'' (f64) f64)) tryInvoke1: self.
+    answer == false ifTrue: [^self fractionPart].
+    ^answer' in: Float.
+@LOOP_COUNT@ timesRepeat: [
+    9.0 ffiDirectDeniedSqrt = 3.0 ifFalse: [self error: 'non-direct descriptor changed semantics']].
+path := 'private-fixture'.
+h := File primOpen: path mode: 0.
+h isNil ifTrue: [self error: 'open fixture failed'].
+[
+    @LOOP_COUNT@ timesRepeat: [
+        (File ffiCandidatePrimPosition: h) = 0 ifFalse: [self error: 'wrong position'].
+        (File ffiCandidatePrimSize: h) = 4096 ifFalse: [self error: 'wrong size']].
+] ensure: [File primClose: h].
+@LOOP_COUNT@ timesRepeat: [
+    (File ffiCandidatePrimPosition: h) isNil ifFalse: [self error: 'closed handle position'].
+    (File ffiCandidatePrimSize: h) isNil ifFalse: [self error: 'closed handle size']].
+(File ffiCandidatePrimPosition: nil) isNil ifFalse: [self error: 'wrong guard fallback'].
+(File ffiCandidatePrimSize: nil) isNil ifFalse: [self error: 'wrong guard fallback'].
+'ffi-direct-ok'
+""".replace("@LOOP_COUNT@", str(n))
+if args.old_image:
+    start = body.index("Compiler compile: 'ffiDirectDeniedSqrt")
+    end = body.index("path :=", start)
+    body = body[:start] + body[end:]
+expr = ("[" + body + "] on: Error do: [:e | Smalltalk vm stderrWrite: e messageText, "
+        "(String with: Character lf). Smalltalk quit: 1]")
+trace_re = re.compile(rb"^ffi-direct trace published=(\d+) success=(\d+) reject=(\d+)\\n\Z", re.M)
+native_re = re.compile(rb"^ffi-native-entry (\d+)$", re.M)
+env = {k: v for k, v in os.environ.items() if k not in (
+    "DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "SAMALTAK_NATIVE_GRANTS",
+    "SAMALTAK_FFI_TRIAL", "SAMALTAK_FFI_TEST_EXPORTS", "LD_PRELOAD")}
+env.update(LC_ALL="C", SDL_VIDEO_DRIVER="parity_no_video", SDL_VIDEODRIVER="parity_no_video",
+           SAMALTAK_FFI_DIRECT_TRACE="1", SAMALTAK_FFI_NATIVE_TRACE="1", SAMALTAK_VERIFY_GC="1",
+           SAMALTAK_FFI_BOX_FULL_GC="1")
+with tempfile.TemporaryDirectory() as temp:
+    Path(temp, "private-fixture").write_bytes(bytes(4096))
+    for mode in args.mode or ("none", "baseline", "opt", "deopt"):
+        for enabled in (0, 1):
+            opts = ["--jit", "opt" if mode == "deopt" else mode, "--jit-threshold", "0", "--jit-opt", "16"]
+            if mode in ("opt", "deopt"):
+                opts += ["--jit-flags", "eager,deopt" if mode == "deopt" else "eager"]
+            command = [args.vm.resolve(), *opts, args.image.resolve(), "--headless", "--eval", expr]
+            r = subprocess.run(command, cwd=temp, env=dict(env, SAMALTAK_FFI_DIRECT=str(enabled)),
+                               capture_output=True, timeout=120)
+            prefix = args.evidence / f"{mode}-{enabled}"
+            prefix.with_suffix(".stdout").write_bytes(r.stdout)
+            prefix.with_suffix(".stderr").write_bytes(r.stderr)
+            assert r.returncode == 0 and b"'ffi-direct-ok'" in r.stdout, (prefix, r.returncode, r.stdout[-200:], r.stderr[-400:])
+            counts = collections.Counter(map(int, native_re.findall(r.stderr)))
+            want = {1076: 3*n, 1528: 2*n, 1529: 2*n}
+            assert counts == want, (prefix, counts)
+            result = trace_re.search(r.stderr)
+            assert result and r.stderr.count(b"ffi-direct trace ") == 1, (prefix, "missing or ambiguous direct result path observer")
+            published, success, reject = map(int, result.groups())
+            if not enabled or args.old_image:
+                assert (published, success, reject) == (0, 0, 0), (prefix, result.groups())
+            else:
+                expected = 7*n
+                # At most one cold seeded call per approved site. The exact-shaped
+                # sqrt method must never publish, and nil from native is success.
+                assert published == 3, (prefix, result.groups())
+                assert expected - published <= success <= expected, (prefix, result.groups())
+                assert reject == 2, (prefix, result.groups())
+            print(f"{prefix.name}: native {want}, direct {published}/{success}/{reject}", flush=True)
