diff --git a/src/VM-Jit/FFIStubCompiler-direct.extension.st b/src/VM-Jit/FFIStubCompiler-direct.extension.st
new file mode 100644
index 0000000..d32670c
--- /dev/null
+++ b/src/VM-Jit/FFIStubCompiler-direct.extension.st
@@ -0,0 +1,388 @@
+VMStruct subclass: #FFIDirectABI
+	instanceVariableNames: ''
+	classVariableNames: ''
+	package: 'VM-Jit'!
+
+!FFIDirectABI class methodsFor: 'declaring'!
+fields
+	^#((base uint64_t) (result uint64_t) (status uint64_t) (errorCell uint64_t)
+		(floatClass uint64_t) (target uint64_t) (counts uint64_t)
+		(okStatus uint32_t) (failStatus uint32_t) (stressBox bool))
+! !
+
+!FFIStubCompiler methodsFor: '*VM-Jit'!
+directEntryFor: desc explicitArgs: explicit abi: site
+	"Publish prim_fn (void(void)). Only scalar lanes from the same approved prepared
+	binding are admitted. ABI addresses name native cells, never movable image oops."
+	<export>
+	<var: #desc type: 'FFIBoundSite *'>
+	<var: #explicit type: 'bool'>
+	<var: #site type: 'FFIDirectABI *'>
+	<returns: 'uint64_t'>
+	| buf bytes size entry argHelper boxHelper stress |
+	(directCount = FFI_DIRECT_LIMIT or: [self canPublishCode not]) ifTrue: [^0].
+	stress := site stressBox.
+	argHelper := explicit ifTrue: [self wrappedArgumentHelper: 3] ifFalse: [0 asUInt64].
+	boxHelper := self wrappedResultHelper: (explicit ifTrue: [12] ifFalse: [6]).
+	buf := self local: 'uint32_t[112]'.
+	bytes := self cCoerce: buf to: 'uint8_t *'.
+	size := asm isX64
+		ifTrue: [self encodeDirectX64: bytes binding: desc explicitArgs: explicit abi: site arg: argHelper box: boxHelper stress: stress]
+		ifFalse: [self encodeDirectArm64: buf binding: desc explicitArgs: explicit abi: site arg: argHelper box: boxHelper stress: stress].
+	(size = 0 or: [size > 448]) ifTrue: [^0].
+	entry := memory publishFFIStub: bytes size: size.
+	entry ~= 0 ifTrue: [directCount := directCount + 1].
+	^entry
+!
+x64DirectR11: value at: p
+	<function>
+	<arch: #x86_64>
+	<var: #value type: 'uint64_t'>
