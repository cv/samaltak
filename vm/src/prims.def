/* Core primitives: PRIM(number, "name", c_function), numbers 1-399.
 * Indices are 1-based over indexable fields. Methods may declare <primitive: 'x' error: ec>;
 * the compiler then sets bit 16 (16r10000) in the method's primitive slot and ec is the
 * first temp; a failing primitive that calls prim_fail_code stores a SmallInteger there.
 * primitiveNames answers an Array whose element n is the name (String) of primitive n, nil for gaps.
 * vmStats answers an Array of SmallIntegers:
 *   1 scavenges  2 full GCs  3 scavenge µs  4 full GC µs  5 old bytes used  6 old budget
 *   7 eden bytes  8 bytes allocated  9 remembered set size  10 process switches  11 bytes tenured  12 weak slots cleared
 *   13 frames flushed into Contexts  14 flushes */

/* SmallInteger: fail on non-SmallInteger args or overflow */
PRIM(1, "intAdd", p_int_add)
PRIM(2, "intSub", p_int_sub)
PRIM(3, "intLess", p_int_less)
PRIM(4, "intGreater", p_int_greater)
PRIM(5, "intLessEq", p_int_less_eq)
PRIM(6, "intGreaterEq", p_int_greater_eq)
PRIM(7, "intEq", p_int_eq)
PRIM(8, "intNotEq", p_int_not_eq)
PRIM(9, "intMul", p_int_mul)
PRIM(10, "intDiv", p_int_div)
PRIM(11, "intMod", p_int_mod)
PRIM(12, "intFloorDiv", p_int_floor_div)
PRIM(13, "intQuo", p_int_quo)
PRIM(14, "intBitAnd", p_int_bit_and)
PRIM(15, "intBitOr", p_int_bit_or)
PRIM(16, "intBitXor", p_int_bit_xor)
PRIM(17, "intBitShift", p_int_bit_shift)
PRIM(18, "intRem", p_int_rem)
PRIM(19, "intAsFloat", p_int_as_float)

/* Float (SmallFloat64 and BoxedFloat64; SmallInteger arguments accepted) */
PRIM(41, "floatAdd", p_float_add)
PRIM(42, "floatSub", p_float_sub)
PRIM(43, "floatLess", p_float_less)
PRIM(44, "floatGreater", p_float_greater)
PRIM(45, "floatLessEq", p_float_less_eq)
PRIM(46, "floatGreaterEq", p_float_greater_eq)
PRIM(47, "floatEq", p_float_eq)
PRIM(48, "floatNotEq", p_float_not_eq)
PRIM(49, "floatMul", p_float_mul)
PRIM(50, "floatDiv", p_float_div)
PRIM(51, "floatTruncated", p_float_truncated)
PRIM(52, "floatFractionPart", p_float_fraction_part)
PRIM(53, "floatExponent", p_float_exponent)
PRIM(54, "floatTimesTwoPower", p_float_times_two_power)
PRIM(55, "floatSqrt", p_float_sqrt)
PRIM(56, "floatSin", p_float_sin)
PRIM(57, "floatCos", p_float_cos)
PRIM(58, "floatArcTan", p_float_arctan)
PRIM(59, "floatLn", p_float_ln)
