PRIM(61, "floatPrintString", p_float_print_string)
PRIM(62, "floatAsIEEEBits", p_float_as_ieee_bits)
PRIM(63, "floatFromIEEEBits", p_float_from_ieee_bits)
PRIM(64, "floatAbs", p_float_abs)

