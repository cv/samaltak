/* Platform primitives (400-699). PRIM(number, "name", c_function).
 * Arguments are listed in order; the receiver is ignored. Handles are
 * SmallIntegers. On failure call platformLastError for the reason.
 * See vm/platform/README.md and the comment blocks in prims_platform.c. */

/* window & input */
PRIM(400, "windowOpen", prim_windowOpen)                 /* w h(points) title flags(1 hidden 2 resizable 4 highDensity) -> win */
PRIM(401, "windowClose", prim_windowClose)               /* win */
PRIM(402, "windowSize", prim_windowSize)                 /* win -> {w. h} points */
PRIM(403, "windowPixelSize", prim_windowPixelSize)       /* win -> {w. h} pixels */
PRIM(404, "windowDisplayScale", prim_windowDisplayScale) /* win -> Float */
PRIM(405, "windowSetTitle", prim_windowSetTitle)         /* win title */
PRIM(406, "windowShow", prim_windowShow)                 /* win */
PRIM(407, "windowHide", prim_windowHide)                 /* win */
PRIM(408, "windowRefreshRate", prim_windowRefreshRate)   /* win -> Float Hz (0 unknown) */
PRIM(409, "setCursor", prim_setCursor)                   /* kind (see pf_window.c) */
PRIM(410, "clipboardGet", prim_clipboardGet)             /* -> String */
PRIM(411, "clipboardSet", prim_clipboardSet)             /* string */
PRIM(412, "nextEvent", prim_nextEvent)                   /* 8-slot Array -> it, filled, or nil */
PRIM(413, "injectEvent", prim_injectEvent)               /* 8-slot Array */
PRIM(414, "inputSemaphore", prim_inputSemaphore)         /* external semaphore index (0 = none) */
PRIM(415, "platformLastError", prim_platformLastError)   /* -> String */
PRIM(416, "vsyncSemaphore", prim_vsyncSemaphore)         /* external semaphore index signaled per display refresh (0 = stop) */
PRIM(417, "platformHandleCounts", prim_platformHandleCounts) /* -> live handles {files. sockets. windows. gpuDevices. shaders. pipelines. textures. samplers. buffers. fences} */
PRIM(418, "droppedEvents", prim_droppedEvents)           /* -> events dropped because the event queue was full (since startup) */

/* GPU */
PRIM(430, "gpuCreateDevice", prim_gpuCreateDevice)       /* debug(Boolean) -> dev */
PRIM(431, "gpuClaimWindow", prim_gpuClaimWindow)         /* dev win */
PRIM(432, "gpuSwapchainFormat", prim_gpuSwapchainFormat) /* dev win -> format */
PRIM(433, "gpuCreateShader", prim_gpuCreateShader)       /* dev msl entry stage samplers uniformBuffers storageBuffers storageTextures */
PRIM(434, "gpuCreatePipeline", prim_gpuCreatePipeline)   /* dev vs fs stride attrs{fmt. off. ...} primitive blend targetFormat */
PRIM(435, "gpuCreateTexture", prim_gpuCreateTexture)     /* dev w h format usage -> tex */
PRIM(436, "gpuCreateSampler", prim_gpuCreateSampler)     /* dev linear(Boolean) repeat(Boolean) -> sampler */
PRIM(437, "gpuCreateBuffer", prim_gpuCreateBuffer)       /* dev usage(1 vertex) size -> buf */
PRIM(438, "gpuRelease", prim_gpuRelease)                 /* handle */
PRIM(439, "gpuUploadBuffer", prim_gpuUploadBuffer)       /* buf bytes byteCount dstOffset */
PRIM(440, "gpuUploadTexture", prim_gpuUploadTexture)     /* tex bytes x y w h bytesPerRow */
PRIM(441, "gpuAcquireCommandBuffer", prim_gpuAcquireCommandBuffer) /* dev -> cmd */
PRIM(442, "gpuAcquireSwapchain", prim_gpuAcquireSwapchain) /* cmd win -> {tex. w. h} or nil */
PRIM(443, "gpuBeginPass", prim_gpuBeginPass)             /* cmd tex clear({r. g. b. a} or nil = load) -> pass */
PRIM(444, "gpuSetViewport", prim_gpuSetViewport)         /* pass x y w h */
PRIM(445, "gpuSetScissor", prim_gpuSetScissor)           /* pass x y w h */
PRIM(446, "gpuBindPipeline", prim_gpuBindPipeline)       /* pass pipeline */
PRIM(447, "gpuBindVertexBuffer", prim_gpuBindVertexBuffer) /* pass slot buf offset */
PRIM(448, "gpuBindTexture", prim_gpuBindTexture)         /* pass slot tex sampler */
PRIM(449, "gpuPushUniforms", prim_gpuPushUniforms)       /* cmdOrPass stage slot bytes */
PRIM(450, "gpuDraw", prim_gpuDraw)                       /* pass vertexCount firstVertex */
PRIM(451, "gpuEndPass", prim_gpuEndPass)                 /* pass */
PRIM(452, "gpuBlit", prim_gpuBlit)                       /* cmd src {x. y. w. h} dst {x. y. w. h} linear */
PRIM(453, "gpuSubmit", prim_gpuSubmit)                   /* cmd wantFence -> fence or nil */
PRIM(454, "gpuWaitFence", prim_gpuWaitFence)             /* fence */
PRIM(455, "gpuFenceDone", prim_gpuFenceDone)             /* fence -> Boolean */
PRIM(456, "gpuDownload", prim_gpuDownload)               /* tex x y w h bytes -> bytes */
PRIM(457, "gpuTextureSize", prim_gpuTextureSize)         /* tex -> {w. h. format} */
PRIM(458, "gpuWaitIdle", prim_gpuWaitIdle)               /* dev */
PRIM(459, "gpuFenceElapsed", prim_gpuFenceElapsed)       /* fence -> µs from submit to completion, or nil while pending */

/* files & processes */
PRIM(500, "fileOpen", prim_fileOpen)                     /* path mode(0 read 1 readWrite 2 append 3 createTruncate) -> file */
PRIM(501, "fileClose", prim_fileClose)                   /* file */
PRIM(502, "fileRead", prim_fileRead)                     /* file bytes start count -> count (0 = EOF) */
PRIM(503, "fileWrite", prim_fileWrite)                   /* file bytes start count -> count */
PRIM(504, "fileSize", prim_fileSize)                     /* file -> Integer */
PRIM(505, "filePosition", prim_filePosition)             /* file -> Integer (0-based) */
PRIM(506, "fileSeek", prim_fileSeek)                     /* file position(0-based) */
PRIM(507, "fileFlush", prim_fileFlush)                   /* file */
PRIM(508, "fileDelete", prim_fileDelete)                 /* path */
PRIM(509, "fileRename", prim_fileRename)                 /* from to */
PRIM(510, "fileStat", prim_fileStat)                     /* path -> {exists. isDirectory. size. mtimeMicroseconds} */
PRIM(511, "dirEntries", prim_dirEntries)                 /* path -> Array of Strings */
PRIM(512, "dirCreate", prim_dirCreate)                   /* path */
PRIM(513, "cwd", prim_cwd)                               /* -> String */
PRIM(514, "mkfifo", prim_mkfifo)                         /* path */
PRIM(515, "spawnProcess", prim_spawnProcess)             /* argv(Array of Strings, PATH lookup) -> pid */
PRIM(516, "processWait", prim_processWait)               /* pid block(Boolean) -> exit status or nil (running) */
PRIM(517, "fileWriteBehind", prim_fileWriteBehind)       /* file bytes start count -> count, 0 if 3 writes are pending (written by a background thread) */

/* sockets */
PRIM(540, "socketListen", prim_socketListen)             /* host port backlog -> socket */
PRIM(541, "socketConnect", prim_socketConnect)           /* host port -> socket */
PRIM(542, "socketAccept", prim_socketAccept)             /* socket -> socket or nil */
PRIM(543, "socketRecv", prim_socketRecv)                 /* socket bytes start count -> count, 0 at EOF, nil would block */
PRIM(544, "socketSend", prim_socketSend)                 /* socket bytes start count -> count or nil */
PRIM(545, "socketClose", prim_socketClose)               /* socket */
PRIM(546, "socketSemaphore", prim_socketSemaphore)       /* socket readIndex [writeIndex] */
PRIM(547, "socketLocalPort", prim_socketLocalPort)       /* socket -> port */
