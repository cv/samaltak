#!/bin/sh
# udhcpc's hook: address, default route and DNS servers of a lease.
case "$1" in
deconfig) ip -4 addr flush dev "$interface"; ip link set "$interface" up ;;
bound|renew)
	ip -4 addr flush dev "$interface"
	ip -4 addr add "$ip/${mask:-24}" dev "$interface"
	for r in $router; do ip -4 route add default via "$r" dev "$interface"; break; done
	: > /etc/resolv.conf; for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
	[ -n "$domain" ] && echo "search $domain" >> /etc/resolv.conf
	echo "samaltak-linux: dhcp $interface $ip at $(cut -d' ' -f1 /proc/uptime) s" > /dev/console ;;
esac
exit 0
