#!/bin/sh
# Take the appliance down (busybox init, before poweroff or reboot): the VM gets SIGTERM from init first.
echo "samaltak-linux: shutting down"
sync
umount /data 2>/dev/null || mount -o remount,ro /data 2>/dev/null
umount /opt/cuda 2>/dev/null
umount /run/cuda-host 2>/dev/null
umount /host 2>/dev/null || mount -o remount,ro /host 2>/dev/null
sync
