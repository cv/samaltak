#!/usr/bin/env node
// samaltak-ctl: drive a running Samaltak image through its control service (ControlServer, JSON lines over
// TCP on 127.0.0.1). See README.md. Node >= 18, no dependencies.
'use strict';

const { spawn } = require('child_process');
const net = require('net');
const path = require('path');
const fs = require('fs');
const os = require('os');

const ROOT = path.resolve(__dirname, '..');
const USAGE = `usage: samaltak-ctl [--session name] <command> [args]
  open [--headless] [--hidden] [--work-clock] [--image path] [--port n] [--window-size WxH] [--source-dir d]   start an image with --control (--work-clock: on the recording clock from the start)
  open --uefi [--headless] [--port n] [--window-size WxH]   the VM on UEFI in QEMU (make uefi-control), its control port forwarded to n
  snapshot [ref] [--depth n] [--bounds]    widget tree with stable @refs
  find <text>                              refs whose label/ref contains text
  click <ref|x,y> [--right] [--mods Shift+Meta]
  dblclick <ref|x,y>    rightclick <ref|x,y>
  hover <ref|x,y> [--at spec]              move the pointer there (--at: a point the widget answers, e.g. a pixel 4,7)
  type <ref> <text> [--end|--start|--replace] [--delay ms] [--preedit]   one command; the image types the characters ms apart (default 45); --preedit: an input method composing text ('' ends it)
  key <combo> [ref]                        e.g. Meta+p, Escape, Meta+.  (Meta = platform modifier)
  drag <ref> <dx> <dy> | drag <ref> <ref>  move windows by their title bar, splitters, handles
  resize <ref> <w> <h>
  select <ref> <text|all|end|from-to|line:n>   editor selection, or list item by label
  scroll <ref> [dy]
  eval <smalltalk>                         prints the printString; exit 3 on a Smalltalk error
  wait <cond> [timeout-ms]                 cond: JSON ({"ref":..,"text":..,"idle":true,"gone":..,"eval":..}), @ref, idle, ms, or text
  advance <ms> | advance <n>f              let time pass (while recording, the image's clock moves only during commands)
  bounds <ref>
  screenshot [ref] <path> [--scale 1|2] [--pointer]   window/widget, or the whole screen (default: display scale)
  record start <out.mp4> [--size WxH] [--fps n] [--raw]   record the screen with ffmpeg (raw RGBA through a FIFO; --raw: <out> gets the RGBA frames, no ffmpeg)
  record stop
  state
  agent-config --from-pi [--provider p] [--model id] [--thinking level]   the agent's model and API key from pi's models.json and settings.json (the key is resolved here and never printed)
  agent-config [--clear]                   the agent's configuration (hasKey, never the key), or forget it
  github-config [--from-gh | --token-command 'cmd'] [--repo owner/name] [--base main] [--prefix agent/]   the GitHub repository and token the image commits through (docs/github.md): the token from gh auth token or cmd's stdout, never printed; repo: origin's, by default
  github-config [--clear]                  the GitHub configuration (hasToken, never the token), or forget it
  update [--dry-run] [--ref main] [--theirs] [--force]   bring the running image up to the branch on GitHub without a restart (docs/github.md): applies the source changes since the image's commit, reports conflicts and what needs a restart; refuses image changes that depend on VM changes of the same range unless --force; exit 1 if nothing could be applied
  close
session: --session, $SAMALTAK_SESSION, default "samaltak"
input commands wait until the image settles (at most 2 s); --settle ms changes that (0: return at once)
exit codes: 1 error, 2 not found or timed out, 3 Smalltalk error`;

let argv = process.argv.slice(2);
let session = process.env.SAMALTAK_SESSION || 'samaltak';
const flags = {};
const pos = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--session') session = argv[++i];
  else if (/^--(depth|mods|timeout|image|port|scale|size|fps|window-size|settle|delay|source-dir|at|provider|model|thinking|token-command|repo|base|prefix|ref)$/.test(a)) flags[a.slice(2)] = argv[++i];
  else if (/^--(headless|hidden|work-clock|raw|headed|bounds|right|end|start|replace|json|pointer|preedit|uefi|from-pi|from-gh|clear|dry-run|theirs|force)$/.test(a)) flags[a.slice(2)] = true;
  else if (a === '-h' || a === '--help') { console.log(USAGE); process.exit(0); }
  else pos.push(a);
}
const [cmd, ...args] = pos;

const DIR = path.join(process.env.TMPDIR || os.tmpdir(), 'samaltak-ctl');
const SESSION_FILE = path.join(DIR, `${session}.json`);

function die(msg, code = 1) { process.stderr.write(`samaltak-ctl: ${msg}\n`); process.exit(code); }
const sleep = ms => new Promise(r => setTimeout(r, ms));
// Commands that wait on the image's clock: real time is not theirs to bound (the machine may be loaded).
const HOUR = 3600000;
const alive = pid => { try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; } };

function readSession() {
  try { return JSON.parse(fs.readFileSync(SESSION_FILE, 'utf8')); } catch (_) { return null; }
}

// Send one request, answer the parsed response.
function request(port, req, timeout = 60000) {
  return new Promise((resolve, reject) => {
    const sock = net.createConnection({ host: '127.0.0.1', port });
    let buf = '';
    const timer = setTimeout(() => { sock.destroy(); reject(new Error(`no answer from the image within ${timeout} ms`)); }, timeout);
    sock.setEncoding('utf8');
    sock.on('connect', () => sock.write(JSON.stringify({ id: 1, ...req }) + '\n'));
    sock.on('data', d => {
      buf += d;
      const nl = buf.indexOf('\n');
      if (nl < 0) return;
      clearTimeout(timer);
      sock.end();
      try { resolve(JSON.parse(buf.slice(0, nl))); } catch (e) { reject(new Error(`bad response: ${buf.slice(0, 200)}`)); }
    });
    sock.on('error', e => { clearTimeout(timer); reject(e); });
    sock.on('close', () => { clearTimeout(timer); if (buf.indexOf('\n') < 0) reject(new Error('connection closed by the image')); });
  });
}

// Like call, but answers a failure ({ok: false, error}) instead of exiting.
async function attempt(req, timeout) {
  const s = readSession();
  for (const t0 = Date.now(); ;) {
    try { return await request(s.port, req, timeout); }
    catch (e) {
      if (e.code === 'ECONNREFUSED' && alive(s.pid) && Date.now() - t0 < 60000) { await sleep(100); continue; }
      return { ok: false, error: e.message };
    }
  }
}

async function call(req, timeout) {
  const s = readSession();
  if (!s) die(`no Samaltak in session ${session} (run: samaltak-ctl open)`);
  if (flags.settle != null && /^(click|hover|type|key|drag|select|scroll|resize)$/.test(req.cmd)) req = { ...req, settle: +flags.settle };
  let r;
  for (const t0 = Date.now(); ;) {
    try { r = await request(s.port, req, timeout); break; }
    catch (e) {
      // Rebuild & reboot: the VM exec'd a new one (same pid), which listens on the same port within seconds.
      if (e.code === 'ECONNREFUSED' && alive(s.pid) && Date.now() - t0 < 60000) { await sleep(100); continue; }
      if (e.code === 'ECONNREFUSED' || e.code === 'ECONNRESET') die(`no Samaltak in session ${session} (run: samaltak-ctl open)`);
      die(e.message);
    }
  }
  if (!r.ok) {
    if (r.code === 3) { delete r.id; console.log(JSON.stringify(r)); process.exit(3); }
    die(r.error || JSON.stringify(r), r.code === 2 ? 2 : 1);
  }
  delete r.ok; delete r.id;
  return r;
}

function print(v) {
  if (typeof v === 'string') console.log(v);
  else if (v !== undefined && v !== null) console.log(JSON.stringify(v, null, flags.json || cmd === 'state' ? 2 : 0));
}
const target = s => {
  if (s == null) die('missing ref');
  const m = String(s).match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
  return m ? { x: +m[1], y: +m[2] } : String(s);
};
const need = (n, what) => { if (args.length < n) die(`${cmd}: ${what}\n${USAGE}`); };

async function open() {
  const old = readSession();
  if (old && alive(old.pid)) {
    try { await request(old.port, { cmd: 'ping' }, 2000); console.log(`already open (session ${session}, pid ${old.pid}, port ${old.port})`); return; }
    catch (_) { /* stale: start a new one */ }
  }
  fs.mkdirSync(DIR, { recursive: true });
  if (flags.uefi) return openUefi();
  const vm = path.join(ROOT, 'vm/build/samaltak');
  const image = path.resolve(flags.image || path.join(ROOT, 'build/samaltak.image'));
  if (!fs.existsSync(vm)) die(`no VM at ${vm} (run: make vm)`);
  if (!fs.existsSync(image)) die(`no image at ${image} (run: make image)`);
  const portFile = path.join(DIR, `${session}.port`);
  const logFile = path.join(DIR, `${session}.log`);
  fs.rmSync(portFile, { force: true });
  const port = flags.port || process.env.SAMALTAK_CONTROL_PORT || '0';
  const vmArgs = [image, '--control', '--control-port', String(port), '--control-port-file', portFile];
  if (flags.headless) vmArgs.push('--headless');
  if (flags.hidden) vmArgs.push('--hidden');
  if (flags['work-clock']) vmArgs.push('--work-clock');
  if (flags['window-size']) vmArgs.push('--window-size', flags['window-size']);
  if (flags['source-dir']) vmArgs.push('--source-dir', path.resolve(flags['source-dir']));
  const log = fs.openSync(logFile, 'w');
  const child = spawn(vm, vmArgs, { cwd: ROOT, detached: true, stdio: ['ignore', log, log] });
  child.unref();
  let exited = null;
  child.on('exit', (code, sig) => { exited = sig || code; });
  const t0 = Date.now();
  for (;;) {
    let p = NaN;
    try { p = parseInt(fs.readFileSync(portFile, 'utf8'), 10); } catch (_) { /* not yet */ }
    if (p > 0) {
      fs.writeFileSync(SESSION_FILE, JSON.stringify({ pid: child.pid, port: p, image, log: logFile, started: new Date().toISOString() }, null, 2));
      // On the work clock nothing runs between commands: this command lets the image start.
      if (flags['work-clock']) await call({ cmd: 'wait', idle: true, eval: 'World current notNil', timeout: 120000 }, HOUR);
      console.log(`opened ${image} (session ${session}, pid ${child.pid}, port ${p})`);
      return;
    }
    if (exited !== null) die(`the image exited (${exited}) before listening; log ${logFile}:\n${fs.readFileSync(logFile, 'utf8').slice(-2000)}`);
    if (Date.now() - t0 > 30000) { try { process.kill(child.pid); } catch (_) {} die(`the image did not start listening within 30 s; log ${logFile}`); }
    await sleep(50);
  }
}

// The VM on UEFI: make uefi-control boots it in QEMU (building it first if needed), its control service on 0.0.0.0 in
// the guest, forwarded from the host's 127.0.0.1:port. The session's pid is make's, the leader of the process group.
async function openUefi() {
  const logFile = path.join(DIR, `${session}.log`);
  const port = flags.port || process.env.SAMALTAK_CONTROL_PORT || await freePort();
  const vmArgs = [];
  if (flags.headless) vmArgs.push('--headless');
  if (flags['window-size']) vmArgs.push('--window-size', flags['window-size']);
  const log = fs.openSync(logFile, 'w');
  const child = spawn('make', ['-s', 'uefi-control', `UEFI_CONTROL_PORT=${port}`, `UEFI_CONTROL_ARGS=${vmArgs.join(' ')}`],
    { cwd: ROOT, detached: true, stdio: ['ignore', log, log] });
  child.unref();
  let exited = null;
  child.on('exit', (code, sig) => { exited = sig || code; });
  const t0 = Date.now();
  for (;;) {
    try {
      await request(+port, { cmd: 'ping' }, 2000);
      fs.writeFileSync(SESSION_FILE, JSON.stringify({ pid: child.pid, group: true, port: +port, uefi: true, log: logFile, started: new Date().toISOString() }, null, 2));
      console.log(`opened the VM on UEFI (session ${session}, pid ${child.pid}, port ${port})`);
      return;
    } catch (_) { /* QEMU forwards the port before the image listens */ }
    if (exited !== null) die(`make uefi-control exited (${exited}) before the image listened; log ${logFile}:\n${fs.readFileSync(logFile, 'utf8').slice(-2000)}`);
    if (Date.now() - t0 > 900000) { killGroup(child.pid); die(`the image did not start listening within 15 min; log ${logFile}`); }
    await sleep(1000);
  }
}

function freePort() {
  return new Promise((resolve, reject) => {
    const srv = net.createServer();
    srv.on('error', reject);
    srv.listen(0, '127.0.0.1', () => { const p = srv.address().port; srv.close(() => resolve(p)); });
  });
}

function killGroup(pid) { try { process.kill(-pid, 'SIGKILL'); } catch (_) { try { process.kill(pid, 'SIGKILL'); } catch (_) {} } }

async function close() {
  const s = readSession();
  if (!s) die(`no Samaltak in session ${session}`);
  try { await request(s.port, { cmd: 'quit' }, 5000); } catch (_) { /* already gone, or hung: killed below */ }
  const t0 = Date.now();
  while (alive(s.pid) && Date.now() - t0 < 5000) await sleep(50);
  if (alive(s.pid)) { if (s.group) killGroup(s.pid); else { try { process.kill(s.pid, 'SIGKILL'); } catch (_) {} } }
  fs.rmSync(SESSION_FILE, { force: true });
  console.log(`closed session ${session}`);
}

// record start <out> spawns ffmpeg reading raw RGBA frames from a FIFO the image writes; record stop ends both.
async function record() {
  const action = args[0];
  const s = readSession();
  if (!s) die(`no Samaltak in session ${session} (run: samaltak-ctl open)`);
  if (action === 'stop') {
    // If the image already quit (it ends the recording itself: ffmpeg sees the end of the FIFO), finish ffmpeg anyway;
    // likewise after Rebuild & reboot, when the new VM does not know the recording the old one ended.
    let r = { frames: '?' };
    const rec = s.recording;
    if (alive(s.pid)) {
      const q = await attempt({ cmd: 'record', action: 'stop' });
      if (q.ok) r = q;
      else if (!rec) die(q.error);
    }
    if (rec) {
      const t0 = Date.now();
      while (alive(rec.pid) && Date.now() - t0 < 30000) await sleep(100);
      if (alive(rec.pid)) { try { process.kill(rec.pid, 'SIGKILL'); } catch (_) {} }
      fs.rmSync(rec.fifo, { force: true });
      delete s.recording;
      fs.writeFileSync(SESSION_FILE, JSON.stringify(s, null, 2));
      console.log(`${rec.out} (${r.frames} frames)`);
    } else print(r);
    return;
  }
  if (action !== 'start' || !args[1]) die(`record: start <out.mp4> [--size WxH] [--fps n] | stop\n${USAGE}`);
  if (s.recording && alive(s.recording.pid)) die('already recording (samaltak-ctl record stop)');
  const out = path.resolve(args[1]);
  let w, h;
  if (flags.size) {
    const m = String(flags.size).match(/^(\d+)x(\d+)$/);
    if (!m) die('record: --size WxH');
    w = +m[1]; h = +m[2];
  } else {
    const st = await call({ cmd: 'state' });
    if (!st.screen) die('record: the image has no screen');
    w = st.screen.w; h = st.screen.h;
  }
  const fps = +(flags.fps || 30);
  if (flags.raw) {
    const r = await attempt({ cmd: 'record', action: 'start', path: out, w, h, fps });
    if (!r.ok) die(r.error || JSON.stringify(r));
    console.log(`recording raw RGBA ${w}x${h} at ${r.fps} fps to ${out} (samaltak-ctl record stop)`);
    return;
  }
  const fifo = path.join(DIR, `${session}.fifo`);
  fs.rmSync(fifo, { force: true });
  require('child_process').execFileSync('mkfifo', [fifo]);
  fs.mkdirSync(path.dirname(out), { recursive: true });
  const log = fs.openSync(path.join(DIR, `${session}.ffmpeg.log`), 'w');
  const ff = spawn('ffmpeg', ['-y', '-loglevel', 'error', '-f', 'rawvideo', '-pix_fmt', 'rgba', '-s', `${w}x${h}`, '-r', String(fps),
    '-i', fifo, '-pix_fmt', 'yuv420p', '-c:v', 'libx264', '-preset', 'veryfast', '-crf', '20', out],
    { detached: true, stdio: ['ignore', log, log] });
  ff.unref();
  let exited = null;
  ff.on('exit', c => { exited = c; });
  ff.on('error', e => { exited = e.message; });
  await sleep(300);
  if (exited !== null) { fs.rmSync(fifo, { force: true }); die(`ffmpeg failed to start (${exited}); see ${path.join(DIR, session + '.ffmpeg.log')}`); }
  s.recording = { pid: ff.pid, out, fifo };
  fs.writeFileSync(SESSION_FILE, JSON.stringify(s, null, 2));
  const r = await attempt({ cmd: 'record', action: 'start', path: fifo, w, h, fps });
  if (!r.ok) {
    // the image did not start recording: no ffmpeg waiting for frames, no recording in the session
    try { process.kill(ff.pid, 'SIGKILL'); } catch (_) {}
    fs.rmSync(fifo, { force: true });
    delete s.recording;
    fs.writeFileSync(SESSION_FILE, JSON.stringify(s, null, 2));
    die(r.error || JSON.stringify(r));
  }
  console.log(`recording ${w}x${h} at ${r.fps} fps to ${out} (samaltak-ctl record stop)`);
}

// agent-config --from-pi: the in-image agent's API-key account (ApiKeyAccount, docs/agent.md) from pi's settings. The key
// is resolved here on the host (a "!command" runs under /bin/sh, its stdout is the key; $NAME/${NAME} interpolate the
// environment) and travels only in the request's JSON over the control connection: never in an argv, never printed.
function piConfig() {
  const dir = process.env.PI_CODING_AGENT_DIR || path.join(os.homedir(), '.pi', 'agent');
  const readJSON = f => { try { return JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')); } catch (e) { die(`agent-config: cannot read ${path.join(dir, f)}: ${e.message}`); } };
  const settings = fs.existsSync(path.join(dir, 'settings.json')) ? readJSON('settings.json') : {};
  const providers = readJSON('models.json').providers || {};
  const name = flags.provider || settings.defaultProvider;
  if (!name || !providers[name]) die(`agent-config: no provider ${JSON.stringify(name)} in ${path.join(dir, 'models.json')} (have: ${Object.keys(providers).join(', ')})`);
  const provider = providers[name];
  const models = provider.models || [];
  const api = m => m.api || provider.api;
  const id = flags.model || (settings.defaultProvider === name && settings.defaultModel) || (models.find(m => api(m) === 'anthropic-messages') || {}).id;
  const model = models.find(m => m.id === id) || { id };
  if (!id) die(`agent-config: provider ${name} has no Anthropic Messages model; name one with --model`);
  if (api(model) !== 'anthropic-messages') die(`agent-config: ${name}/${id} speaks ${api(model)}; the agent speaks anthropic-messages only`);
  const level = flags.thinking || settings.defaultThinkingLevel || 'high';
  const mapped = model.thinkingLevelMap && model.thinkingLevelMap[level];
  const thinking = level === 'off' ? 'off' : typeof mapped === 'string' ? mapped
    : ({ minimal: 'low', low: 'low', medium: 'medium', high: 'high' })[level] || 'high';
  if (provider.apiKey == null) die(`agent-config: provider ${name} has no apiKey`);
  return { provider: name, baseUrl: model.baseUrl || provider.baseUrl, model: id, thinking, maxTokens: model.maxTokens || 32000, contextWindow: model.contextWindow, apiKey: resolveSecret(String(provider.apiKey), name) };
}

function resolveSecret(spec, name) {
  if (spec.startsWith('!')) {
    let out;
    try { out = require('child_process').execFileSync('/bin/sh', ['-c', spec.slice(1)], { stdio: ['ignore', 'pipe', 'inherit'], encoding: 'utf8', maxBuffer: 1 << 20 }); }
    catch (e) { die(`agent-config: the apiKey command of provider ${name} failed (exit ${e.status ?? e.signal ?? '?'})`); }
    const key = out.trim();
    if (!key) die(`agent-config: the apiKey command of provider ${name} printed nothing`);
    return key;
  }
  const key = spec.replace(/^\$!/, '!').replace(/\$\$|\$\{(\w+)\}|\$(\w+)/g, (m, a, b) => {
    if (m === '$$') return '$';
    const v = process.env[a || b];
    if (v == null) die(`agent-config: the apiKey of provider ${name} names $${a || b}, which is not set`);
    return v;
  });
  if (!key) die(`agent-config: the apiKey of provider ${name} is empty`);
  return key;
}

async function agentConfig() {
  if (flags.clear) return print(await call({ cmd: 'agent-config', clear: true }));
  if (!flags['from-pi']) {
    if (flags.provider || flags.model || flags.thinking) die('agent-config: --provider, --model and --thinking go with --from-pi');
    return print(await call({ cmd: 'agent-config' }));
  }
  if (!readSession()) die(`no Samaltak in session ${session} (run: samaltak-ctl open)`);
  // The answer is the image's configuration with hasKey, never the key.
  return print(await call({ cmd: 'agent-config', ...piConfig() }));
}

// github-config: the GitHub repository and token the image's SourceFiler commits through (GitHubAccount, docs/github.md).
// The token is read here on the host, from gh auth token (--from-gh) or a command's stdout (--token-command, under
// /bin/sh), and travels only in the request's JSON over the control connection: never in an argv, never printed.
function originRepository() {
  let url;
  try { url = require('child_process').execFileSync('git', ['remote', 'get-url', 'origin'], { stdio: ['ignore', 'pipe', 'ignore'], encoding: 'utf8' }).trim(); }
  catch (_) { die('github-config: no origin remote here; name the repository with --repo owner/name'); }
  const m = url.match(/github\.com[:/]+([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+?)(?:\.git)?\/?$/);
  if (!m) die(`github-config: origin (${url}) is not a GitHub repository; name one with --repo owner/name`);
  return `${m[1]}/${m[2]}`;
}

function githubToken() {
  const [program, argv, what] = flags['from-gh']
    ? ['gh', ['auth', 'token'], 'gh auth token']
    : ['/bin/sh', ['-c', flags['token-command']], 'the token command'];
  let out;
  try { out = require('child_process').execFileSync(program, argv, { stdio: ['ignore', 'pipe', 'inherit'], encoding: 'utf8', maxBuffer: 1 << 20 }); }
  catch (e) { die(`github-config: ${what} failed (exit ${e.status ?? e.signal ?? e.code ?? '?'})`); }
  const token = out.trim();
  if (!token) die(`github-config: ${what} printed nothing`);
  if (/\s/.test(token)) die(`github-config: ${what} printed more than one word`);
  return token;
}

async function githubConfig() {
  if (flags.clear) return print(await call({ cmd: 'github-config', clear: true }));
  if (flags['from-gh'] && flags['token-command']) die('github-config: --from-gh or --token-command, not both');
  const fromHost = flags['from-gh'] || flags['token-command'];
  if (!fromHost && !flags.repo && !flags.base && !flags.prefix) return print(await call({ cmd: 'github-config' }));
  if (!readSession()) die(`no Samaltak in session ${session} (run: samaltak-ctl open)`);
  const repository = flags.repo || originRepository();
  const req = { cmd: 'github-config', repository, baseBranch: flags.base || 'main', branchPrefix: flags.prefix || 'agent/' };
  if (fromHost) req.token = githubToken();
  if (flags['from-gh'])
    process.stderr.write(`samaltak-ctl: note: gh's token reaches every repository your gh login can; prefer a fine-grained token for ${repository} only (contents and pull requests: write) with --token-command (docs/github.md)\n`);
  // The answer is the image's configuration with hasToken, never the token.
  return print(await call(req));
}

// update: the image applies the source changes between the commit it is at and the branch's head on GitHub
// (SourceFiler default updateFrom:, docs/github.md), through the account github-config set.
async function update() {
  const req = { cmd: 'update' };
  if (flags.ref) req.ref = flags.ref;
  if (flags['dry-run']) req.dryRun = true;
  if (flags.theirs) req.takeTheirs = true;
  if (flags.force) req.force = true;
  const r = await call(req, 30 * 60000);
  if (flags.json) return print(r);
  console.log(r.summary);
  if (r.base || r.head) console.log(`${r.base || '?'} -> ${r.head || '?'}`);
  for (const [key, title] of [['applied', r.state === 'preview' ? 'would apply' : 'applied'], ['conflicts', 'conflicts'], ['failures', 'failures'], ['needsRestart', 'needs restart'], ['hostSide', 'host side'], ['vmDependent', 'depends on VM changes'], ['notApplied', 'not applied'], ['notes', 'notes']])
    if (r[key] && r[key].length) console.log(`${title}:\n${r[key].map(x => '  ' + x).join('\n')}`);
  if (r.state === 'failed' || r.state === 'partial') process.exit(1);
}

async function main() {
  switch (cmd) {
    case 'open': return open();
    case 'close': return close();
    case 'snapshot': {
      const o = { cmd: 'snapshot' };
      if (args[0]) o.ref = args[0];
      if (flags.depth != null) o.depth = +flags.depth;
      if (flags.bounds) o.bounds = true;
      const r = await call(o);
      return print(r.text.replace(/\n$/, ''));
    }
    case 'find': {
      need(1, 'find <text>');
      const r = await call({ cmd: 'find', text: args.join(' ') });
      if (!r.matches.length) die(`nothing matches ${JSON.stringify(args.join(' '))}`, 2);
      for (const n of r.matches) console.log(`${n.role} ${n.ref} ${JSON.stringify(n.label)}`);
      return;
    }
    case 'click': need(1, 'click <ref|x,y>'); return print(await call({ cmd: 'click', target: target(args[0]), button: flags.right ? 'right' : 'left', mods: flags.mods }));
    case 'rightclick': need(1, 'rightclick <ref|x,y>'); return print(await call({ cmd: 'click', target: target(args[0]), button: 'right', mods: flags.mods }));
    case 'dblclick': need(1, 'dblclick <ref|x,y>'); return print(await call({ cmd: 'click', target: target(args[0]), count: 2, mods: flags.mods }));
    case 'hover': need(1, 'hover <ref|x,y> [--at spec]'); return print(await call({ cmd: 'hover', target: target(args[0]), at: flags.at }));
    case 'type': need(2, 'type <ref> <text>'); return print(await call({ cmd: 'type', target: target(args[0]), text: args.slice(1).join(' '), at: flags.end ? 'end' : flags.start ? 'start' : undefined, replace: !!flags.replace, preedit: !!flags.preedit, delay: +(flags.delay ?? 45) }));
    case 'key': need(1, 'key <combo> [ref]'); return print(await call({ cmd: 'key', combo: args[0], target: args[1] ? target(args[1]) : undefined }));
    case 'drag':
      need(2, 'drag <ref> <dx> <dy> | drag <ref> <ref>');
      if (args.length >= 3 && !isNaN(+args[1]) && !isNaN(+args[2])) return print(await call({ cmd: 'drag', target: target(args[0]), dx: +args[1], dy: +args[2], mods: flags.mods }));
      return print(await call({ cmd: 'drag', target: target(args[0]), to: target(args[1]), mods: flags.mods }));
    case 'resize': need(3, 'resize <ref> <w> <h>'); return print(await call({ cmd: 'resize', target: args[0], w: +args[1], h: +args[2] }));
    case 'select': {
      need(2, 'select <ref> <spec>');
      const s = args.slice(1).join(' ');
      let spec = s, m;
      if ((m = s.match(/^(\d+)-(\d+)$/))) spec = { from: +m[1], to: +m[2] };
      else if ((m = s.match(/^line:(\d+)$/))) spec = { line: +m[1] };
      return print(await call({ cmd: 'select', target: args[0], spec }));
    }
    case 'scroll': need(1, 'scroll <ref> [dy]'); return print(await call({ cmd: 'scroll', target: target(args[0]), dy: args[1] != null ? +args[1] : 120 }));
    case 'eval': {
      need(1, 'eval <smalltalk>');
      const o = { cmd: 'eval', source: args.join(' ') };
      if (flags.timeout) o.timeout = +flags.timeout;
      const r = await call(o, 24 * 3600 * 1000);
      return print(r.printString);
    }
    case 'wait': {
      need(1, 'wait <cond> [timeout]');
      const a = args[0];
      let cond;
      if (a.startsWith('{')) { try { cond = JSON.parse(a); } catch (e) { die(`wait: bad JSON: ${e.message}`); } }
      else if (a === 'idle') cond = { idle: true };
      else if (a.startsWith('@')) cond = { ref: a };
      else if (/^\d+$/.test(a)) cond = { ms: +a };
      else cond = { text: a };
      const t = +(args[1] || flags.timeout || cond.timeout || 10000);
      return print(await call({ ...cond, cmd: 'wait', timeout: t }, HOUR));
    }
    case 'advance': {
      need(1, 'advance <ms> | advance <n>f');
      const frames = args[0].match(/^(\d+)f$/);
      return print(await call(frames ? { cmd: 'advance', frames: +frames[1] } : { cmd: 'advance', ms: +args[0] }, HOUR));
    }
    case 'bounds': need(1, 'bounds <ref>'); return print(await call({ cmd: 'bounds', target: args[0] }));
    case 'state': return print(await call({ cmd: 'state' }));
    case 'screenshot': {
      need(1, 'screenshot [ref] <path>');
      const file = path.resolve(args[args.length - 1]);
      fs.mkdirSync(path.dirname(file), { recursive: true });
      const o = { cmd: 'screenshot', path: file };
      if (args.length > 1) o.target = args[0];
      if (flags.scale) o.scale = +flags.scale;
      if (flags.pointer) o.pointer = true;
      // An image on UEFI cannot write this machine's files: it answers the PNG.
      if (readSession()?.uefi) o.inline = true;
      const r = await call(o);
      if (r.png) fs.writeFileSync(file, Buffer.from(r.png, 'base64'));
      return print(file);
    }
    case 'record': return record();
    case 'agent-config': return agentConfig();
    case 'github-config': return githubConfig();
    case 'update': return update();
    case undefined: console.log(USAGE); process.exit(1); break;
    default: die(`unknown command ${JSON.stringify(cmd)}\n${USAGE}`);
  }
}

main().catch(e => die(e && e.message || String(e)));
