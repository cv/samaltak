#!/bin/sh
# On Linux (Ubuntu, DGX OS) on a machine Samaltak is installed on (docs/uefi.md, Installing): boot Samaltak once,
# now. Finds the boot option "Samaltak" that the installer added (for \EFI\samaltak\BOOTAA64.EFI or BOOTX64.EFI),
# sets the firmware's BootNext to it (efibootmgr --bootnext; BootOrder stays, so the next boot after that is
# Linux again) and reboots. Samaltak's World menu has "Reboot into Ubuntu" (System) for the way back.
#
# usage: tools/reboot-into-samaltak [--no-reboot] [--dry-run]
#   --no-reboot   only set BootNext (the next reboot, whenever it is, boots Samaltak)
#   --dry-run     say what it would do, change nothing
# Needs efibootmgr (sudo apt install efibootmgr) and root for the change (it runs sudo).
set -eu
reboot=1
dry=0
for a; do
	case $a in
	--no-reboot) reboot=0 ;;
	--dry-run | -n) dry=1 ;;
	-h | --help) sed -n '2,11p' "$0"; exit 0 ;;
	*) echo "reboot-into-samaltak: unknown option $a" >&2; exit 2 ;;
	esac
done
command -v efibootmgr > /dev/null || { echo "reboot-into-samaltak: needs efibootmgr (sudo apt install efibootmgr)" >&2; exit 1; }
[ -d "${EFI_SYSFS:-/sys/firmware/efi}" ] || { echo "reboot-into-samaltak: Linux was not booted by UEFI" >&2; exit 1; }
n=$(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]\)\*\{0,1\}[[:space:]][[:space:]]*Samaltak\([[:space:]].*\)\{0,1\}$/\1/p' | head -n 1)
[ -n "$n" ] || n=$(efibootmgr -v | grep -i 'EFI.samaltak.BOOT' | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p' | head -n 1)
[ -n "$n" ] || { echo "reboot-into-samaltak: no boot option Samaltak (efibootmgr lists the options; install it from the boot stick)" >&2; exit 1; }
sudo=
[ "$(id -u)" = 0 ] || sudo=sudo
run() {
	if [ $dry = 1 ]; then echo "would run: $*"; else "$@"; fi
}
echo "reboot-into-samaltak: Boot$n is Samaltak"
run $sudo efibootmgr --bootnext "$n"
[ $reboot = 1 ] && run $sudo systemctl reboot
exit 0
