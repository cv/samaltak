#!/bin/sh
# tls-survey: compare the Smalltalk TLS client's verdict on real HTTPS servers with OpenSSL's (opt-in: it needs the
# internet). For each host of HOSTFILE (default tools/tls-survey-hosts.txt: host[:port], an optional tab-separated note,
# # comments): openssl s_client with the system's roots, certificate and host name verified, once with any version and
# once TLS 1.3 only; then the image (TLSSurvey) with the Smalltalk TLS and the Mozilla roots: handshake, HEAD /, read
# until the server closes. Prints a table (host, OpenSSL's verdict, protocol and TLS 1.3 verdict, ours, the details)
# and writes the raw results to OUT (default build/tls-survey). Exit status 1 if a verdict differs.
#   usage: tools/tls-survey [-j JOBS] [-o OUT] [-i IMAGE] [HOSTFILE | host...]
set -eu
if [ "${1:-}" = --openssl-one ]; then
	# "spec<TAB>ok|fail<TAB>protocol<TAB>TLS 1.3 ok|fail<TAB>why"
	spec=$2 host=${2%%:*} port=443
	case $spec in *:*) port=${spec#*:} ;; esac
	r=$(timeout 20 openssl s_client -connect "$host:$port" -servername "$host" -verify_hostname "$host" \
		-verify_return_error -alpn http/1.1 -brief < /dev/null 2>&1) || true
	# s_client can exit 0 when the server just closes: established means a CONNECTION ESTABLISHED line.
	printf '%s\n' "$r" | grep -q '^CONNECTION ESTABLISHED' && v=ok || v=fail
	proto=$(printf '%s\n' "$r" | sed -n 's/^Protocol version: //p' | head -1)
	why=$(printf '%s\n' "$r" | grep -iE 'verify error|alert|error|errno|refused|unknown' | head -1 | tr '\t' ' ' | cut -c1-120)
	timeout 20 openssl s_client -connect "$host:$port" -servername "$host" -tls1_3 -brief < /dev/null 2>&1 \
		| grep -q '^CONNECTION ESTABLISHED' && v13=ok || v13=fail
	printf '%s\t%s\t%s\t%s\t%s\n' "$spec" "$v" "${proto:--}" "$v13" "${why:--}"
	exit 0
fi
cd "$(dirname "$0")/.."
JOBS=8 OUT=build/tls-survey IMAGE=build/samaltak.image
while getopts j:o:i: opt; do
	case $opt in
	j) JOBS=$OPTARG ;;
	o) OUT=$OPTARG ;;
	i) IMAGE=$OPTARG ;;
	*) sed -n 's/^#   //p' "$0" >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
mkdir -p "$OUT"
if [ $# -eq 1 ] && [ -f "$1" ]; then
	grep -v '^#' "$1" | grep -v '^[[:space:]]*$' > "$OUT/hosts"
elif [ $# -ge 1 ]; then
	printf '%s\n' "$@" > "$OUT/hosts"
else
	grep -v '^#' tools/tls-survey-hosts.txt | grep -v '^[[:space:]]*$' > "$OUT/hosts"
fi
cut -f1 "$OUT/hosts" > "$OUT/names"

# OpenSSL, JOBS hosts at a time.
xargs -P "$JOBS" -n 1 tools/tls-survey --openssl-one < "$OUT/names" > "$OUT/openssl.tsv"

# The Smalltalk TLS, JOBS connections at a time in one image.
timeout 900 vm/build/samaltak "$IMAGE" --headless --eval \
	"(TLSSurvey new runFile: '$OUT/names' parallel: $JOBS) size" < /dev/null > "$OUT/smalltalk.out" 2>&1 || true
awk -F '\t' '$2 == "ok" || $2 == "fail"' "$OUT/smalltalk.out" > "$OUT/smalltalk.tsv"

# The table, in the hosts' order.
awk -F '\t' '
	FILENAME == ARGV[1] { o[$1] = $2; op[$1] = $3; o13[$1] = $4; ow[$1] = $5; next }
	FILENAME == ARGV[2] { s[$1] = $2; d = ""; for (i = 3; i <= NF; i++) d = d (i > 3 ? " " : "") $i; sd[$1] = d; next }
	{ h = $1; note = $2; total++
	  ours = (h in s) ? s[h] : "none"
	  mark = (o[h] == ours) ? "" : "MISMATCH"
	  if (mark != "") n++
	  printf "%-36s %-4s %-7s 1.3:%-4s | %-4s %-8s %s%s%s\n", h, o[h], op[h], o13[h], ours, mark, sd[h], \
		(o[h] == "fail" ? "  [openssl: " ow[h] "]" : ""), (note != "" ? "  (" note ")" : "")
	}
	END { printf "\n%d hosts, %d mismatches\n", total, n; exit n > 0 }
' "$OUT/openssl.tsv" "$OUT/smalltalk.tsv" "$OUT/hosts" | tee "$OUT/table.txt"
